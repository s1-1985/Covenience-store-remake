msgid "Year %d · Month %d, Day %d"
msgstr "%02d年目%02d月%02d日"

msgid "%d units"
msgstr "%d個"

msgid "%d items / ¥%s"
msgstr "%d点／¥%s"

msgid "no active customers"
msgstr "お客さんは店内にいない"

