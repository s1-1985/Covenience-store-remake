msgstr "%s（人気度%d）"

msgid "Scenario cleared — reached %d stores (you can keep playing)"
msgstr "目標の%d店舗に到達！ 引き続き遊べる"

msgid "population %s, %d rival store%s, land ¥%s"
msgstr "人口%s人／競合%d店%s／地価¥%s"

msgid "Restock %s (stock: %d)"
msgstr "%sを補充（在庫%d）"

msgid "Expand chain (¥%s, currently %d store(s))"
msgstr "出店 ¥%s（現在%d店）"

msgid "Set price policy (currently %+d%%)"
msgstr "価格を設定（現在%+d%%）"

msgid "Cash went negative at a day/month boundary."
msgstr "日付の切り替わりに所持金がマイナスとなった。"

msgid "100 years passed without reaching the scenario's clear condition."
msgstr "目標未達のまま100年が経過した。"

msgid "Layout reset to configured prototype"
msgstr "開始時の状態に戻した"

msgid "No customer currently at checkout to eject"
msgstr "レジに対象のお客さんがいない"

msgid "Ejected customer %s before they could get angry"
msgstr "お客さん%sをつまみ出した"

msgid "Could not eject %s"
msgstr "%sをつまみ出せなかった"

msgid "Selected: %s — tap another fixture to swap"
msgstr "%sを選択中：入れ替える設備をタップ"

msgid "Selected: %s — tap an empty grid cell to move"
msgstr "%sを選択中：移動先の空きマスをタップ"

msgid "Moved %s to (%d, %d)"
msgstr "%sを（%d, %d）へ移動した"

msgid "Finish the active visit before editing layout"
msgstr "お客さんの退店後に内装を変更できる"

msgid "Cannot move there: blocked, outside, or route would break"
msgstr "移動できない。空きスペースと通路を確認"

msgid "Select a fixture before rotating"
msgstr "回転する設備を選択"

msgid "Rotated %s clockwise"
msgstr "%sを回転した"

msgid "Cannot rotate there: blocked or route would break"
msgstr "スペースや通路を確保できないため回転できない"

msgid "Swapped %s and %s"
msgstr "%sと%sを入れ替えた"

msgid "Cannot swap those: route would break"
msgstr "通路がなくなるため入れ替えできない"

msgid "Select a fixture before selling"
msgstr "売却する設備を選択"

msgid "Sold %s"
msgstr "%sを売却した"

msgid "Finish the active visit before selling a fixture"
msgstr "お客さんの退店後に売却できる"

msgid "Cannot sell that fixture: it's the checkout, holds stock, or has no catalog price"
msgstr "レジ・在庫のある棚・価格不明の設備は売却できない"

msgid "Deselected"
msgstr "選択を解除した"

msgid "Loaded sample layout: %s"
msgstr "内装の見本%sを読み込んだ"

msgid "Finish the active visit before loading a sample layout"
msgstr "お客さんの退店後に内装の見本を使える"

msgid "Cannot load that sample layout: unaffordable or would strand stocked inventory"
msgstr "資金不足、または在庫の置き場所がなくなるため変更できない"

msgid "Buying %s — tap an empty grid cell to place it"
msgstr "%sを購入：配置先の空きマスをタップ"

msgid "Cannot place %s there: no open cell next to it for customers/staff to use"
msgstr "%sの隣に利用する人のための通路が必要"

msgid "Purchased %s"
msgstr "%sを購入した"

msgid "Finish the active visit before buying a fixture"
msgstr "お客さんの退店後に設備を購入できる"

msgid "Cannot place %s there: blocked, unaffordable, or route would break"
msgstr "%sを置けない。資金・空きスペース・通路を確認"

msgid "Already hold the %s permit"
msgstr "%sの販売許可は取得済み"

msgid "Purchased permit: %s"
msgstr "%sの販売許可を取得した"

msgid "Finish the active visit before buying a permit"
msgstr "お客さんの退店後に販売許可を取得できる"

msgid "Cannot afford the %s permit"
msgstr "%sの販売許可を取得する資金が足りない"

msgid "No shelf fixture available to stock (buy one first)"
msgstr "商品を置く棚がない。先に棚を購入"

msgid "Stocked %s on %s"
msgstr "%sを%sに仕入れた"

msgid "Finish the active visit before stocking a product"
msgstr "お客さんの退店後に仕入れできる"

msgid "Cannot stock %s on %s: missing permit, unaffordable, or already stocked there"
msgstr "%sを%sに仕入れできない。販売許可・資金・棚の在庫を確認"

msgid "Select a shelf whose stock is running low to restock it"
msgstr "在庫が少なくなった棚を選択すると補充できる"

msgid "Restocked %d units of %s for ¥%s"
msgstr "%d個の%sを補充した（¥%s）"

msgid "Finish the active visit before restocking"
msgstr "お客さんの退店後に補充できる"

msgid "Scheduled promotion: %s"
msgstr "広告%sを申し込んだ"

msgid "Finish the active visit before buying a promotion"
msgstr "お客さんの退店後に広告を申し込める"

msgid "Cannot buy that promotion: unaffordable or already scheduled/used this month"
msgstr "資金不足、または今月すでに申し込み済みの広告である"

msgid "Expanded the chain to %d store(s)"
msgstr "%d店舗になった"

msgid "Finish the active visit before expanding the chain"
msgstr "お客さんの退店後に出店できる"

msgid "Cannot expand the chain: unaffordable, or the scenario target is already reached"
msgstr "資金不足、またはこの試作版の出店上限に到達している"

msgid "Price policy set: %+d%% from list price"
msgstr "定価から%+d%%の価格に設定した"

msgid "Finish the active visit before changing the price policy"
msgstr "お客さんの退店後に価格を変更できる"

msgid "Cannot set that price policy (must be -100% or above)"
msgstr "価格は定価の-100%以上で指定"

msgid "No candidate available to hire"
msgstr "雇える候補者がいない"

msgid "Hired %s into %s"
msgstr "%sを%sに雇用した"

msgid "Finish the active visit before hiring"
msgstr "お客さんの退店後に雇用できる"

msgid "Cannot hire %s into %s"
msgstr "%sを%sに雇用できない"

msgid "%s — ¥%s/unit"
msgstr "%s：仕入れ単価¥%s"

msgid "%s — ¥%s (+%d popularity)"
msgstr "%s：¥%s（人気度+%d）"

msgid "%s — register %d / replen %d / ¥%s/day (体力%s 学歴%s 敏捷性%s 社交性%s)"
msgstr "%s：レジ%d／補充%d／日給¥%s（体力%s 学歴%s 敏捷性%s 社交性%s）"

msgid "PROVISIONAL PLAYABLE CLIENT\nTiming/layout values are not recovered original rules."
msgstr "再現試作版：原作と異なる仮仕様を含む"

