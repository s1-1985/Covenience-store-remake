; Convenience Store Remake production-client seed.
; Godot 4 project. Gameplay-sensitive prototype values live under data/ and are
; explicitly marked provisional rather than being treated as recovered rules.

config_version=5

[application]
config/name="Convenience Store Remake"
config/icon="res://assets/menu_icons/fixtures/register_1.png"
run/main_scene="res://scenes/main_menu.tscn"

[autoload]
GameLaunchState="*res://scripts/game_launch_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}

[internationalization]
locale/translations=PackedStringArray("res://locale/ja.po")
locale/fallback="en"

[gui]
theme/custom_font="res://fonts/ConveniJP.ttf"
